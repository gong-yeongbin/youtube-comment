{
	"name": "backend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "nest build",
		"dev": "nest start --watch",
		"start": "node dist/main",
		"lint": "eslint .",
		"check-types": "tsc --noEmit",
		"test": "jest --passWithNoTests",
		"test:watch": "jest --watch"
	},
	"dependencies": {
		"@google/genai": "^2.32.0",
		"@nestjs/common": "^11.1.28",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.28",
		"@nestjs/platform-express": "^11.1.28",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"yaml": "^2.9.1",
		"youtube-transcript-plus": "^2.0.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.23",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.28",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.1",
		"jest": "^30.4.2",
		"source-map-support": "^0.5.21",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.2",
		"typescript": "6.0.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"diagnostics": {
						"ignoreCodes": [
							151002
						]
					}
				}
			]
		},
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^(\\.{1,2}/.*)\\.js$": "$1"
		}
	}
}
